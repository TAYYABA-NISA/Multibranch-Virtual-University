# Copy to .env and edit. Never commit .env
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:4000
APP_URL=http://localhost:4000

# Email. Leave SMTP_HOST empty and emails are printed in the terminal instead (good for development).
# For Mailtrap (free) paste the SMTP settings from its inbox page.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ExamSlot <no-reply@examslot.test>
